{
  "name": "Fazelan Jamia Foundation",
  "image": "mcr.microsoft.com/devcontainers/php:8.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Next.js Frontend", "onAutoForward": "notify" },
    "8000": { "label": "Laravel API", "onAutoForward": "notify" }
  }
}
